---
const {id} = Astro.props;
let img ;
let name;
let types;
let typpes;
if (id ){
  console.log(id)
  if (!id) {
  throw new Error("No id provided. Visit /pokemon/147 or similar.");
}
  const response = await fetch(`https://pokeapi.co/api/v2/pokemon/${id}`);
  const typesurl = await fetch("https://pokeapi.co/api/v2/type/")
  const body =  await response.json();
   img = body.sprites.front_shiny
   name = body.name
  const str = JSON.stringify(body,null,2)
  console.log(str)

   types = await typesurl.json()
   typpes = types.results.map((element)=>element.name)
}
else{

}
---
<img src={img}/>
<p>
  {name}
</p>
<pre>
{typpes}
</pre>

